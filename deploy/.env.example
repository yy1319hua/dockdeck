# ============================================================================
# DockDeck 部署环境变量 —— 复制为 .env 后填写（.env 与 secrets/ 不入库，
# .gitignore 已覆盖；本 example 文件本身入库）。
#     cp deploy/.env.example deploy/.env
# ============================================================================

# 【必填】本机对外绑定 IP：tailscale 网卡 IP 或内网具体 IP。
#   tailscale ip -4            # tailscale 场景现取
#   ip -4 addr show eth0       # 内网场景现取
# hub/agent 两个角色都用它绑各自端口（8443 / 9527）；不填 compose 直接报错，
# 不会带着空地址启动。0.0.0.0 会被应用层拒绝（只放行具体 IP）。
DD_BIND_IP=100.x.y.z

# 【Agent 机必填】Agent↔Hub 共享令牌。不走环境变量、走文件挂载
# （docker inspect 看不到文件内容）：
#     install -m 600 /dev/null deploy/secrets/agent.token
#     printf '%s' '<Hub 侧纳管时生成的 Agent 令牌>' > deploy/secrets/agent.token
# 若坚持用环境变量：删掉 compose 里 agent command 的 --token-file 两行，
# 并在 agent 服务下加：environment: / DD_AGENT_TOKEN: "<令牌>"。

# 【可选】镜像与版本（不填用 compose 文件里的默认值；发布新版本时改这里）
# DD_HUB_IMAGE=ghcr.io/yy1319hua/dockdeck-hub:latest
# DD_AGENT_IMAGE=ghcr.io/yy1319hua/dockdeck-agent:latest

# 【可选】Hub TLS 模式：self（自签，默认；指纹见设置页）
#                        none（明文，仅允许回环监听，反代场景用）
# DD_HUB_TLS_MODE=self

# 【可选】Agent 启动时向 Hub 自注册纳管（S5.8）。需同时取消 compose 里
# agent 服务的 environment 注释块；不填 = 不自注册（HubURL 空即关闭）。
# DD_HUB_URL=https://<hub 的 tailnet IP 或域名>:8443
# DD_AGENT_JOIN_SECRET=<一次性纳管密钥>
